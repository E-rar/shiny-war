# Kopiere diese Datei zu ".env" und trage deinen echten Bot-Token ein.
# Die echte .env wird NICHT ins Git-Repo hochgeladen (siehe .gitignore).

DISCORD_TOKEN=hier-deinen-discord-bot-token-einsetzen

# ID des Channels, in dem der Bot reagieren soll (0 = überall)
ALLOWED_CHANNEL_ID=0

# Automatisches Pushen der hunts.json.enc ins Repo (für die gehostete Web-App).
# 1 = an, 0 = aus. Verzögerung in Sekunden nach der letzten Änderung (Standard 300 = 5 Min).
GIT_AUTO_PUSH=1
GIT_PUSH_DELAY=120

# Zugangsschutz: gemeinsames Passwort fürs Bober Board. MUSS identisch zu dem sein,
# was Nutzer in der Web-App eingeben. Der Bot verschlüsselt damit hunts.json.enc und
# verteilt es per /zugang. Wähle etwas Langes/Zufälliges.
BOARD_PASSWORD=hier-ein-langes-geheimes-passwort-setzen
